# Copy this file to .env and fill in your values.
# Never commit .env - it is in .gitignore.

# Base URL of the Roosterly helpdesk API (from the assignment email).
NORDAVO_HELPDESK=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk

# The key from the assignment email (same for every candidate in this round).
NORDAVO_KEY=nrd_round_xxxxxxxxxxxxxxxxxxxx

# The e-mail address you applied with - this identifies YOUR account.
# A different address is a different account. Always use the same one.
NORDAVO_ME=you@example.com

# Optional: your full name, sent as X-Candidate-Name.
# NORDAVO_NAME=Your Full Name

# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for triage, drafting and verification (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Max LLM calls per minute (stay under your Gemini tier's limit; free tier is low).
LLM_RPM=10

# Optional: Gemini thinking budget in tokens (0 = off). Unset = model default.
# GEMINI_THINKING_BUDGET=0

# Optional: paid-tier prices in USD per 1M tokens, only used to report cost per 100 tickets.
# Known defaults exist for gemini-3.5-flash-lite (0.30 / 2.50).
# PRICE_INPUT_PER_M=0.30
# PRICE_OUTPUT_PER_M=2.50
